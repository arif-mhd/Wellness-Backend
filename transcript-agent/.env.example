# Same LiveKit project the backend and both clients already use — this
# worker just joins rooms as a silent participant, same credentials.
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret0000000000000000000000

# Deepgram — https://console.deepgram.com/ -> API Keys
DEEPGRAM_API_KEY=

# Cloud Translation API (Basic/v2, key-only auth) — enable
# translate.googleapis.com on the GCP project, then create a key restricted
# to just that service (Console -> APIs & Services -> Credentials, or
# `gcloud services api-keys create --api-target=service=translate.googleapis.com`).
# Used only for live-caption translation; never touches STT or the saved transcript.
GOOGLE_TRANSLATE_API_KEY=

# The main backend's own base URL and its existing internal-cron secret
# (same one appointment-reminders/sweep already uses in backend/.env) — this
# worker calls back into it to read an appointment's consultationLanguage and
# to save the finished transcript.
BACKEND_URL=http://localhost:3001
INTERNAL_CRON_SECRET=
