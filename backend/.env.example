# Copy this file to .env and fill in your values
# cp .env.example .env

# Server
PORT=3001

# SuperTokens Core (the auth server you run via Docker). REQUIRED in
# production (NODE_ENV=production) — without a real value, this and the two
# domain vars below default to localhost, which in production would silently
# point auth requests, cookies, and redirects at a nonexistent local server.
SUPERTOKENS_CONNECTION_URI=http://localhost:3567

# The URL of THIS backend, and of the primary frontend (doctor portal) that
# SuperTokens issues cookies/redirects for. Both REQUIRED in production —
# see the note above.
API_DOMAIN=http://localhost:3001
WEBSITE_DOMAIN=http://localhost:3002

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wellness_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Allowed frontend origins (comma-separated)
DOCTOR_PORTAL_URL=http://localhost:3002
ADMIN_PORTAL_URL=http://localhost:3003
PATIENT_APP_URL=http://localhost:8081

# Google Gemini API — used for AI food image analysis
# Get your free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Resend — sends OTP emails (login 2FA, fee-change/withdrawal verification,
# registration, password reset). REQUIRED in production: NODE_ENV=production
# deploys (see Dockerfile) never fall back to logging the code to the
# console, so a missing/invalid key or an unverified sending domain makes
# every OTP-send request fail with a 500, not just silently misbehave.
RESEND_API_KEY=your_resend_api_key_here
# Must be on a domain verified in your Resend account — the default sandbox
# sender (onboarding@resend.dev) only delivers to the account owner's own
# email, so it will 500 for every other recipient in production.
RESEND_FROM_EMAIL=Wellness Central <noreply@yourdomain.com>

# LiveKit — powers video consultations and in-app chat. REQUIRED — the
# backend refuses to start without both set (no built-in dev fallback).
# For local dev against a self-hosted LiveKit server, devkey/devsecret is
# fine; a real deployment MUST use real LiveKit Cloud (or self-hosted)
# credentials, never these placeholder values.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret0000000000000000000000
# LIVEKIT_WS_URL is the shared fallback; the _DOCTOR/_PATIENT variants let
# each side connect through a different edge endpoint if needed. Also
# REQUIRED in production — same "no silent localhost fallback" reasoning as
# the SuperTokens vars above.
LIVEKIT_WS_URL=ws://localhost:7880
# LIVEKIT_WS_URL_DOCTOR=ws://localhost:7880
# LIVEKIT_WS_URL_PATIENT=ws://localhost:7880
