# Copy this file to .env.local and restart the dev server
# cp .env.local.example .env.local

NEXT_PUBLIC_API_URL=https://backend-741878858011.asia-south1.run.app

# Which white-label organization this portal deployment belongs to (see
# organizations.slug in the backend). Sent on clinic self-signup so new
# clinics land in the right org instead of the platform default. Leave unset
# for the default "wellness" deployment.
NEXT_PUBLIC_ORG_SLUG=wellness
