# Copy this file to .env.local and restart the dev server
# cp .env.local.example .env.local

NEXT_PUBLIC_API_URL=https://backend-741878858011.asia-south1.run.app

# The brand this build is for (see organizations.slug in the backend). Set it
# explicitly for EVERY deployment, including the platform's own.
#
# Leaving it unset is not a safe default: the portal then sends no X-Org-Slug
# header, and the backend's cross-org sign-in guard only runs when that header
# is present (src/config/supertokens.ts). With no header the check is skipped
# entirely, so any client's account could sign into that portal.
#
# It also scopes clinic self-signup, so new clinics land in the right org.
NEXT_PUBLIC_ORG_SLUG=wellness
